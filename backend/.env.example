# Copy this to .env and fill in your values. NEVER commit .env to git.

# Flask core
FLASK_SECRET_KEY=change-me-to-a-long-random-hex-string-at-least-64-chars
FLASK_DEBUG=false

# JWT
JWT_SECRET_KEY=change-me-to-a-different-long-random-hex-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///noorhub_dev.db

# CORS - set to your frontend URL
ALLOWED_ORIGIN=http://localhost:5173

# Google OAuth (optional, leave blank if not using)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
